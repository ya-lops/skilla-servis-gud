---
import Button from "@/components/ui/Button.astro";
import type { BrandData } from "@/types/brand";
import HeroFeatures from "../blocks/HeroFeatures.astro";

interface Props {
  brandData: BrandData;
  type: "main" | "about";
}

const { brandData, type = "main" } = Astro.props;

import { getGlobalMinPriceWithDiscount, getDiscountPercent } from "@/utils/price";

const discount = getDiscountPercent(brandData.main.adv_price_percent);

const { price, discountedPrice, showDiscount } = getGlobalMinPriceWithDiscount(brandData.services, discount);

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

{
  type == "main" && (
    <>
      <section
        class="hero relative grid grid-cols-[100%] min-h-[800px] mt-[-140px] pt-[140px] bg-hero-main-surface text-hero-main-text overflow-clip isolate"
        data-cmp="Hero"
      >
        <div class="container h-full">
          <div class="_hero-inner grid grid-cols-1 items-start lg:items-center h-full">
            <div class="_hero-image absolute inset-0 -z-1">
              <img class="object-cover h-full w-full" src="/images/hero-main.webp" alt="" fetchpriority="high" />
            </div>

            <div class="_hero-content flex flex-col gap-10 p-10 max-w-[43.25rem] rounded-4xl bg-surface-primary add-shadow">
              <h1 class="_hero-title typo-h1 text-balance">
                Грузчики в&nbsp;{brandData.main.city_rod}
                <div>
                  от{" "}
                  {brandData.main?.adv_price && Number(brandData.main.adv_price) > 0
                    ? brandData.main.adv_price
                    : showDiscount
                      ? discountedPrice
                      : price}{" "}
                  рублей
                </div>
              </h1>

              <p class="max-w-[289px] typo-t3">Ваш заказ готовы выполнить прямо сейчас 354 исполнителя</p>

              <div class="_hero-actions flex flex-col lg:flex-row items-start lg:items-center gap-6 lg:gap-8">
                <div class="_hero-actions-items">
                  <Button href="#kp" variant="accent" text="Получить КП" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <HeroFeatures />
    </>
  )
}

{
  type == "about" && (
    <section
      class="hero relative min-h-[800px] mt-[-196px] pt-[196px] bg-hero-about-surface text-hero-main-text overflow-clip isolate"
      data-cmp="Hero"
    >
      <div class="container h-full">
        <div class="_hero-inner grid grid-cols-1 items-start lg:items-center h-full">
          <div class="_hero-image absolute inset-0 -z-1">
            <img class="object-cover h-full w-full" src="/images/hero-about.webp" alt="" fetchpriority="high" />
          </div>

          <div class="_hero-content flex flex-col gap-10 p-10 max-w-[43.25rem] rounded-4xl bg-surface-primary add-shadow">
            <h1 class="_hero-title typo-h1 text-left text-balance isolate">Работаем с 2010 года по всей России</h1>

            <p class="typo-t3">354 проверенных исполнителя в базе</p>

            <div class="_hero-actions flex items-center gap-8">
              <div class="_hero-actions-items">
                <Button href={`/${firstServiceUrl}`} variant="secondary" text="Наши услуги" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
