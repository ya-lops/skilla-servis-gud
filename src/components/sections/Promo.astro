---
import type { BrandData } from "@/types/brand";
import Button from "../ui/Button.astro";
import IconSvg from "../IconSvg.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const discount = brandData.main.adv_price_percent;

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

<section class="promo relative z-2 bg-promo-surface overflow-clip" data-cmp="Promo">
  <div class="container relative">
    <div class="_promo-inner flex items-center lg:justify-center gap-7 pl-1 pr-3 lg:px-0 lg:gap-15 max-w-[747px] mx-auto">
      <div class="flex items-center gap-5">
        <div
          class="_promo-value flex items-center justify-center py-1 px-2 rounded-xl text-button-surface-accent-inverse text-xl font-bold border border-outline"
        >
          -{discount}%
        </div>

        <div class="_promo-description flex flex-col py-2">
          <p class="text-promo-text-primary text-md font-bold">Только в сентябре</p>
          <p class="text-promo-text-secondary typo-t4 font-medium">скидка {discount}% на все услуги</p>
        </div>
      </div>

      <div class="_promo-actions ml-auto lg:ml-0">
        <Button
          href={`/${firstServiceUrl}`}
          variant="secondary"
          text="В каталог"
          class="bg-button-surface-accent text-text-primary-inverse !h-[34px]"
        />
      </div>
    </div>
  </div>
</section>
