---
import type { BrandData } from "@/types/brand";
import IconSvg from "../IconSvg.astro";

interface Props {
  brandData: BrandData;
  type: "cards" | "timeline" | "flow";
}

const { brandData } = Astro.props;

const steps = [
  {
    title: "Просто звоните и заказываете",
    text: "Мы рассчитаем вам точную стоимость услуги",
    image: "/images/how-1.webp",
  },
  {
    title: "Рабочие приезжают точно вовремя",
    text: "Трезые, вежливые граждане РФ приезжают к вам без опозданий",
    image: "/images/how-2.webp",
  },
  {
    title: "Выполняем качественно работу",
    text: "Быстро, и аккуратно выполняют работу",
    image: "/images/how-3.webp",
  },
  {
    title: "Вы получаете документы",
    text: "Все необходимые бухгалтерские документы",
    image: "/images/how-4.webp",
  },
];
---

<section class="how-we-work py-8 md:py-10 lg:py-20" data-cmp="HowWeWork">
  <div class="container">
    <h2 class="_how-we-work-title pb-16 text-text-primary">Как мы работаем</h2>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      {
        steps.map((step: any, index: number) => (
          <div class="flex flex-col items-center gap-3 lg:gap-4 p-8 pb-0 rounded-2xl shadow-[0px_4px_24px_0px_hsla(0,0%,36%,0.1)]">
            <div class="text-center typo-h3 text-button-surface-accent-inverse">{index + 1}.</div>
            <h3 class="typo-t1 text-center balance text-text-primary">{step.title}</h3>
            <h3 class="typo-t3 text-center balance text-text-primary mb-12">{step.text}</h3>
            <div class="relative flex items-end justify-center mt-auto">
              <img src={step.image} loading="lazy" alt="" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
